@model PagesModel.ViewModel
@section HeaderSection{
    @Html.Raw(Model.PageTextHeaderHtml)
    @if(Model.HasPageImageHttpPath)
    {
        <meta property="og:image" content="@Html.Raw(Model.PageOgImageHttpPath)" />
    }
}
<main class="app-page t63-page">    
    @Html.Raw(Model.PageText)
</main>
@section FooterSection{
    @Html.Raw(Model.PageTextFooterHtml)
}