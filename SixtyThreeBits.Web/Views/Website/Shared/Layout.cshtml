@{
    var Model = WebUtilities.GetLayoutViewModel<WebsiteLayoutViewModel>(viewData: ViewData, key: WebConstants.ViewData.LayoutViewModel);
}
<!DOCTYPE html>
<html lang="@Model.LanguageCode">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <title>@Html.Raw(Model.PageTitle.TitleHead)</title>

    <!-- Google Fonts - Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="~/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- Gifter Design System -->
    <link href="~/css/website/gifter.css" rel="stylesheet">
    <link href="~/css/website/style.css" rel="stylesheet">

    <!-- Ionicons -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    @RenderSection("HeaderSection", false)
    @Html.Raw(Model.ScriptsHeader)
</head>

<body class="bg-rich-black text-foreground">
    @Html.Raw(Model.ScriptsBodyStart)

    <div class="ambient-light">
        <div class="app-container">
            <!-- Header -->
            @await Html.PartialAsync("~/Views/Website/Shared/_HeaderPartial.cshtml", Model)

            <!-- Main Content -->
            <main class="flex-grow-1 overflow-auto hide-scrollbar px-4 pb-5">
                @RenderBody()
            </main>

            <!-- Footer -->
            @await Html.PartialAsync("~/Views/Website/Shared/_FooterPartial.cshtml", Model)
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>

    <!-- Core Scripts -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/website/gifter-layout.js"></script>
    <script src="~/js/website/components.js"></script>

    @RenderSection("FooterSection", false)
    @Html.Raw(Model.ScriptsBodyEnd)
</body>

</html>
