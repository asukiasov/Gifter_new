@{
    var Model = WebUtilities.GetLayoutViewModel<WebsiteLayoutViewModel>(viewData: ViewData, key: WebConstants.ViewData.LayoutViewModel);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <title>@Html.Raw(Model.PageTitle.TitleHead)</title>
    @await Html.PartialAsync(ViewNames.Shared.PluginsClient.PluginsClientHeaderPartial, Model.PluginsClient)    
    <link href="/css/website/style.css" rel="stylesheet" />

    @RenderSection("HeaderSection", false)
    @Html.Raw(Model.ScriptsHeader)
</head>
<body>
    @Html.Raw(Model.ScriptsBodyStart)
    <div class="app">
        <header class="app-header">
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container-fluid">
                    <a class="navbar-brand" href="/">@Html.Raw(Model.ProjectName)</a>                    
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        @if (Model.HasMenu)
                        {
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                @foreach(var item in Model.Menu)
                                {
                                    if(item.HasChildren)
                                    {
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown">
                                                @Html.Raw(item.Caption)
                                            </a>                                            
                                            <ul class="dropdown-menu">
                                                @foreach(var child in item.Children)
                                                {
                                                    @if (child.IsSelected)
                                                    {
                                                        <li><a class="dropdown-item active">@Html.Raw(child.Caption)</a></li>
                                                    }
                                                    else
                                                    {
                                                        <li><a class="dropdown-item" href="@Html.Raw(child.NavigateUrl)">@Html.Raw(child.Caption)</a></li>
                                                    }
                                                }                                                                                                
                                            </ul>
                                        </li>
                                    }
                                    else
                                    {
                                        if(item.IsSelected)
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link active">@Html.Raw(item.Caption)</a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" href="@Html.Raw(item.NavigateUrl)">@Html.Raw(item.Caption)</a>
                                            </li>                                            
                                        }
                                    }
                                }                                                                
                            </ul>
                        }
                    </div>
                </div>
            </nav>            
        </header>
        @RenderBody()
        <footer class="app-page">
        </footer>
    </div>
    @await Html.PartialAsync(ViewNames.Shared.PluginsClient.PluginsClientFooterPartial, Model.PluginsClient)
    <script src="/js/website/layout.js"></script>
    @RenderSection("FooterSection", false)
    @Html.Raw(Model.ScriptsBodyEnd)
</body>
</html>