@{
    Layout = ViewNames.Admin.Shared.Layout;
    var Model = WebUtilities.GetLayoutViewModel<UserLayoutViewModel>(viewData: ViewData, key: WebConstants.ViewData.UserLayoutViewModel);
}
@section HeaderSection{
    @RenderSection(Model.HeaderSectionName, false)
}
<div class="row">
    <div class="col-xxl-3">
        <div class="user-sidebar">
            <div class="card">
                <div class="card-body p-0">
                    <div class="user-profile-img">
                        <img src="/images/admin_profile_bg_pattern.jpg" class="profile-img profile-foreground-img rounded-top" />
                        <div class="overlay-content rounded-top">
                        </div>
                    </div>
            
                    <div class="mt-n5 position-relative">
                        <div class="text-center">
                            <img src="/images/no_avatar.svg" alt="" class="avatar-xl rounded-circle img-thumbnail">
                            <div class="mt-3">
                                <h5 class="mb-1">@Html.Raw(Model.UserFullname)</h5>                                
                                <div>
                                    @if (Model.UserIsActive)
                                    {
                                        <text><i class="fa-solid fa-circle text-success"></i> Active</text>
                                    }
                                    else
                                    {
                                        <text><i class="fa-solid fa-circle text-danger"></i> Inactive</text>
                                    }                                    
                                </div>                                
                            </div>

                        </div>
                    </div>
            
                    <div class="p-3 mt-3">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <div class="p-1">
                                    <h5 class="mb-1">1,269</h5>
                                    <p class="text-muted mb-0">Products</p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-1">
                                    <h5 class="mb-1">5.2k</h5>
                                    <p class="text-muted mb-0">Followers</p>
                                </div>
                            </div>
                        </div>
            
                                               
                    </div>
                </div>
                <!-- end card body -->
            </div>
            <!-- end card -->

            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Personal Information</h4>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>Role</span>
                        <span class="text-secondary">@Html.Raw(Model.RoleName)</span>
                    </div>
                   <hr />
                    <div class="d-flex justify-content-between">
                        <span>Reg. Date</span>
                        <span class="text-secondary">@Html.Raw(Model.UserDateCreated)</span>
                    </div>                    
                </div>
            </div>
        </div>
    </div>

    <div class="col-xxl-9">
        <div class="card">
            <ul class="nav nav-tabs nav-tabs-custom nav-justified">
                @if (Model.HasTabs)
                {
                    @foreach (var item in Model.Tabs)
                    {
                        @if (item.IsSelected)
                        {
                            <li class="nav-item">
                                <a class="nav-link active">
                                    <i class="@Html.Raw(item.Icon) fa-lg"></i>
                                    <span class="d-none d-sm-block">@Html.Raw(item.Caption)</span> 
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Html.Raw(item.NavigateUrl)">
                                    <i class="@Html.Raw(item.Icon) fa-lg"></i>
                                    <span class="d-none d-sm-block">@Html.Raw(item.Caption)</span>
                                </a>
                            </li>
                        }
                    }
                }
            </ul>
            <div class="tab-content p-4">
                <div class="tab-pane active">
                    @RenderBody()
                </div>
            </div>
        </div>


    </div>
</div>
@section FooterSection{
    @RenderSection(Model.FooterSectionName, false)
}