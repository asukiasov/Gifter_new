@model PartnerPropertiesModel.PageViewModel
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel { FormID = "form", CssClass = "js-show-preloader" })
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <form id="form" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextPublished)</label>
                    <label class="toggler toggler-lg">
                        <input type="checkbox" name="@nameof(Model.PartnerIsPublished)" value="true" @(Model.PartnerIsPublished ? Html.Raw("checked") : null) />
                        <i></i>
                    </label>
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextName) *</label>
                    <input value="@Model.PartnerName" name="@nameof(Model.PartnerName)" class="form-control js-partner-name" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextNameEng)</label>
                    <input value="@Model.PartnerNameEng" name="@nameof(Model.PartnerNameEng)" type="text" class="form-control js-partner-name-eng" />
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextPageUrl)</label>
                    <input name="@nameof(Model.PartnerWebSite)" value="@Model.PartnerWebSite" type="text" class="form-control js-partner-website-url" />
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextUploadImage)</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-custom-file-upload-attachment" data-type="image" href="@Html.Raw(Model.PartnerImageHttpPath)">@Html.Raw(Model.PartnerImageFilename)</a>
                            <span class="js-custom-file-upload-new-attachment hidden"></span>
                        </div>
                        @if (Model.ShowPartnerImageDeleteButton)
                        {
                            <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-outline-light js-custom-file-upload-delete-button"><i class="fa-light fa-trash-can"></i></button>
                        }
                        <button type="button" class="btn btn-outline-light hidden js-custom-file-upload-clear-button"><i class="fa fa-times"></i></button>
                        <span class="btn btn-outline-light custom-file-upload">
                            <i class="fas fa-folder-open"></i>
                            <input type="file" name="@nameof(Model.PartnerImageFile)" accept="image/*" />
                        </span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionShort)</label>
                    <textarea name="@nameof(Model.PartnerShortDescription)" class="form-control">@Model.PartnerShortDescription</textarea>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionShortEng)</label>
                    <textarea name="@nameof(Model.PartnerShortDescriptionEng)" class="form-control">@Model.PartnerShortDescriptionEng</textarea>
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescription)</label>
                    <textarea name="@nameof(Model.PartnerFullDescription)" class="form-control js-apply-tinymce">@Model.PartnerFullDescription</textarea>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionEng)</label>
                    <textarea name="@nameof(Model.PartnerFullDescriptionEng)" class="form-control js-apply-tinymce">@Model.PartnerFullDescriptionEng</textarea>
                </div>                
            </div>
            
        </form>
    </div>
</div>
@section FooterSection{
<script src="/js/admin/partners/partnerProperties.js"></script>
@if (Model.HasErrors)
{
    <script>
    validation.init({ errorsJson: @Html.Raw(Model.ErrorsJson)}).showErrors();
    </script>
}
}