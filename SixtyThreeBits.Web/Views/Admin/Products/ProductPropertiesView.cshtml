@model ProductPropertiesModel.ViewModel
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSavePartialView, new ButtonSaveViewModel { FormID = "form", CssClass = "js-show-preloader" })
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <form id="form" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextCaption) *</label>
                    <input type="text" name="@nameof(Model.ProductName)" class="form-control" value="@Model.ProductName" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextCaptionEng)</label>
                    <input type="text" name="@nameof(Model.ProductNameEng)" class="form-control" value="@Model.ProductNameEng" />
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-2">
                    <label>@Html.Raw(Model.TextPublished)</label>
                    <label class="toggler toggler-lg">
                        <input type="checkbox" name="@nameof(Model.ProductIsPublished)" value="true" @(Model.ProductIsPublished ? Html.Raw("checked") : null) />
                        <i></i>
                    </label>
                </div>
                <div class="form-group col-lg-2">
                    <label>@Html.Raw(Model.TextFeatured)</label>
                    <label class="toggler toggler-lg">
                        <input type="checkbox" name="@nameof(Model.ProductIsFeatured)" value="true" @(Model.ProductIsFeatured ? Html.Raw("checked") : null) />
                        <i></i>
                    </label>
                </div>
                <div class="col-lg-2 form-group">
                    <label>SKU</label>
                    <input name="@nameof(Model.ProductSKU)" class="form-control" value="@Html.Raw(Model.ProductSKU)" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextCategory)</label>
                    <select class="form-control" name="@nameof(Model.ProductCategoryID)">
                        <option></option>
                        @foreach (var Item in Model.Categories)
                        {
                            <option value="@Item.Key" @(Item.IsSelected ? Html.Raw("selected") : null)>@Html.Raw(Item.Value)</option>
                        }
                    </select>
                    <p class="help-block"></p>
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-2 form-group">
                    <label>@Html.Raw(Model.TextPrice)</label>
                    <input name="@nameof(Model.ProductPrice)" class="form-control js-numeric-input" value="@Model.ProductPrice" />
                </div>
                <div class="col-lg-2 form-group">
                    <label>@Html.Raw(Model.TextPriceOld)</label>
                    <input name="@nameof(Model.ProductPriceOld)" class="form-control js-numeric-input" value="@Model.ProductPriceOld" />
                </div>
                <div class="col-lg-2 form-group">
                    <label>@Html.Raw(Model.TextRemainder)</label>
                    <input name="@nameof(Model.ProductRemainder)" class="form-control js-numeric-input" value="@Model.ProductRemainder" />
                </div>
     
                <div class="col-lg-3 form-group">
                    <label>@Html.Raw(Model.TextBrand)</label>
                    <select class="form-control" name="@nameof(Model.BrandID)">
                        <option></option>
                        @foreach (var Item in Model.Brands)
                        {
                            <option value="@Item.Key" @(Item.IsSelected ? Html.Raw("selected") : null)>@Item.Value</option>
                        }
                    </select>
                    <p class="help-block"></p>
                </div>
                <div class="col-lg-3 form-group">
                    <label>@Html.Raw(Model.TextProducerCountry)</label>
                    <select name="@nameof(Model.CountryIDProducer)" class="form-control">
                        <option></option>
                        @if (Model.HasProductProducerCountries)
                        {
                            foreach (var Item in Model.ProductProducerCountries)
                            {
                                <option value="@Html.Raw(Item.Key)" @(Item.IsSelected ? Html.Raw("selected") : null)>@Html.Raw(Item.Value)</option>
                            }
                        }
                    </select>
                </div>
        
            </div>            
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionShort)</label>
                    <textarea type="text" name="@nameof(Model.ProductDescriptionShort)" class="form-control">@Html.Raw(Model.ProductDescriptionShort)</textarea>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionShortEng)</label>
                    <textarea type="text" name="@nameof(Model.ProductDescriptionShortEng)" class="form-control">@Html.Raw(Model.ProductDescriptionShortEng)</textarea>
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescription)</label>
                    <textarea name="@nameof(Model.ProductDescription)" class="form-control js-apply-tinymce">@Html.Raw(Model.ProductDescription)</textarea>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionEng)</label>
                    <textarea name="@nameof(Model.ProductDescriptionEng)" class="form-control js-apply-tinymce">@Html.Raw(Model.ProductDescriptionEng)</textarea>
                </div>                
            </div>
        </form>        
    </div>
</div>
<div class="card file-uploader-card">
    <div class="card-header">
        <h4>@Html.Raw(Model.TextPhotos)</h4>
    </div>
    <div class="card-body">
        <div class="row row-px-sm js-product-images-container">
            @if (Model.HasProductImages)
            {
                foreach (var Item in Model.ProductImages)
                {
                    <div class="col-md-4 col-xl-2 js-product-image-item" data-id="@Html.Raw(Item.ProductImageID)">
                        <figure class="embed-responsive img-wrap mb-1 radius-bottom-none">
                            <img class="embed-responsive-item js-product-image" src="@Html.Raw(Item.ProductImageFileHttpPath)" />
                            <a class="remove-btn js-product-image-delete-button" href="#" tabindex="-1">
                                <i class="fa-light fa-trash-can"></i>
                            </a>
                        </figure>
                        <div class="form-group">
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm alt-input js-product-image-alt-text-textbox" value="@Html.Raw(Item.ProductImageAltText)" placeholder="Enter Alt Text" tabindex="0" />
                                <div class="input-group-append">
                                    <button class="btn btn-sm btn-primary alt-save-btn js-product-image-save-button" type="button" tabindex="-1"><i class="fas fa-save"></i></button>
                                </div>
                            </div>
                            <div class="invalid-feedback"></div>
                        </div>
                    </div>
                }
            }
            <div class="col-md-4 col-xl-2 js-product-images-uploader-container">
                <label class="uploader-container">
                    <span class="wrap">
                        <i class="fas fa-plus"></i>
                        <span>@Html.Raw(Model.TextUploadImage)</span>
                    </span>
                    <input type="file" class="js-product-images-uploader" accept="image/*" multiple />
                </label>
            </div>
        </div>
    </div>
</div>
@section FooterSection{

    <script id="productImageProgressTemplate" type="text/template7">
        <div class="col-md-4 col-xl-2 js-product-image-item" data-filename="{{productImageFilename}}">
            <div class="uploader-progress-wrap">
                <div class="wrap">
                    <span class="d-block text-truncate">{{productImageFilename}}</span>
                    <div class="progress">
                        <div class="progress-bar js-progress-bar" style="width: {{productImageFileUploadProgressPercent}}%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </script>
    <script id="productImageTemplate" type="text/template7">
        <div class="col-md-4 col-xl-2 js-product-image-item" data-id="{{ProductImageID}}">
            <figure class="embed-responsive img-wrap mb-1 radius-bottom-none">
                <img class="embed-responsive-item js-product-image" src="{{ProductImageFileHttpPath}}" />
                <a class="remove-btn js-product-image-delete-button" href="#" tabindex="-1">
                    <i class="fa-light fa-trash-can"></i>
                </a>
            </figure>
            <div class="form-group">
                <div class="input-group">
                    <input type="text" class="form-control form-control-sm alt-input js-product-image-alt-text-textbox" value="" placeholder="Enter Alt Text" tabindex="0" />
                    <div class="input-group-append">
                        <button class="btn btn-sm btn-primary alt-save-btn js-product-image-save-button" type="button" tabindex="-1"><i class="fas fa-save"></i></button>
                    </div>
                </div>
                <div class="invalid-feedback"></div>
            </div>
        </div>
    </script>

    <script src="/js/admin/products/ProductPropertiesView.js"></script>
    <script>
        model.urlImageUpload = '@Html.Raw(Model.UrlImageUpload)';
        model.urlImageUpdate = '@Html.Raw(Model.UrlImageUpdate)';
        model.urlImageDelete = '@Html.Raw(Model.UrlImageDelete)';
        model.urlImageSort = '@Html.Raw(Model.UrlImageSort)';
        model.textConfirmDeleteImage = '@Html.Raw(Model.TextConfirmDeleteImage)';
    </script>
    @if (Model.HasErrors)
    {
        @if (Model.HasFormErrors)
        {
            <script>
                validation.init({ errorsJson: @Html.Raw(Model.FormErrorsJson) }).showErrors();
            </script>
        }
        @if (Model.HasToastError)
        {
            <script>
                successErrorToast63Bits.init({isError:true,message:'@Html.Raw(Model.ToastError)'}).showMessage();
            </script>
        }
    }
}