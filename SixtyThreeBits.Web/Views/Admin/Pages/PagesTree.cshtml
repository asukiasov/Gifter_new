@model PagesTreeModel.PageViewModel

@section HeaderSection{
    <link href="/css/admin/SortableTree.css" rel="stylesheet" />
}
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                @if (Model.ShowAddNewButton)
                {
                    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonAddNew, new ButtonAddNewViewModel { JsSelector = "js-show-create-new-page-modal-button" })
                }
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">        
        <div class="row">
            <div class="col">
                @await Html.PartialAsync(ViewNames.Admin.Shared.FileTreeEditor.Editor, Model.Pages)
            </div>
        </div>
    </div>
</div>

<div class="modal fade js-create-new-page-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">გვერდის დამატება</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col form-group">
                        <label>გვერდის დასახელება</label>
                        <input type="text" class="form-control js-create-new-page-modal-page-title-input" />                        
                        <input type="hidden" class="js-create-new-page-modal-parent-page-id-hf" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel { JsSelector = "js-create-new-page-modal-save-button"})
            </div>

        </div>
    </div>
</div>


@section FooterSection{
    

    <script src="/js/admin/Pages/PagesTree.js"></script>    
    <script>
    pagesTreeModel.urlCreateNew = '@Model.UrlCreateNew';
    pagesTreeModel.urlUpdate = '@Model.UrlUpdate';
    pagesTreeModel.urlDelete = '@Model.UrlDelete';
    pagesTreeModel.urlSyncParentsAndSortIndexes = '@Model.UrlSyncParentsAndSortIndexes';
    pagesTreeModel.textConfirmDeleteRecord = '@Model.TextConfirmDeleteRecord';
    pagesTreeModel.textConfirmDeleteRecursive = '@Model.TextConfirmDeleteRecursive';
    pagesTreeModel.validationRequiredPageTitle = '@Model.ValidationRequired';
    </script>
}