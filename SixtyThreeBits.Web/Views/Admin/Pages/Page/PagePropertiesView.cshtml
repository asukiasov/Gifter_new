@model PagePropertiesModel.ViewModel
@section HeaderSection{
}


<form method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col d-flex justify-content-between">
            @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSavePartialView, new ButtonSaveViewModel {CssClass = "js-show-preloader"})
            <a href="@Html.Raw(Model.UrlPreview)" target="_blank" class="btn btn-light btn-rounded"><i class="fa-solid fa-eye"></i> @Html.Raw(Model.TextPreview)</a>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="form-group col-lg-2">
            <label>@Html.Raw(Model.TextPublished)</label>
            <label class="toggler toggler-lg">
                <input type="checkbox" id="IsPublishedChechBox" name="@nameof(Model.PageIsPublished)" value="true" @(Model.PageIsPublished ? Html.Raw("checked") : null) />
                <i></i>
            </label>
        </div>        
        <div class="form-group col-lg-4">                    
            <label>@Html.Raw(Model.TextUploadImage) <a href="#" class="js-short-description-and-image-info"><i class="fa-solid fa-circle-info"></i></a></label>
            <div class="input-group custom-file-group js-custom-file-upload">
                <div class="form-control">
                    <a class="js-custom-file-upload-attachment" data-type="image" href="@Model.PageImageHttpPath">@Model.PageImageFilename</a>
                    <span class="js-custom-file-upload-new-attachment hidden"></span>
                </div>
                @if (Model.HasPageImage)
                {                
                    <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-outline-light js-custom-file-upload-delete-button"><i class="fa-light fa-trash-can"></i></button>
                }                
                <button type="button" class="btn btn-outline-light hidden js-custom-file-upload-clear-button"><i class="fa fa-times"></i></button>                
                <span class="btn btn-outline-light custom-file-upload">
                    <i class="fas fa-folder-open"></i>
                    <input type="file" name="@nameof(Model.PageImageFile)" accept="image/*" />
                </span>                
            </div>
        </div>
        <div class="form-group col-lg-6">
            <div class="d-flex justify-content-between">
                <label>@Html.Raw(Model.TextSlug) *</label>
                <div class="dropdown">
                    <a href="javascript:void(0)" class="dropdown-toggle" data-bs-toggle="dropdown">
                        @Html.Raw(Model.TextGenerateFromTitle)
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="#" class="dropdown-item js-generate-slug-from-title" data-title-input-selector=".js-title-input" data-slug-input-selectpr=".js-slug-input">@Html.Raw(Model.TextTitle)</a></li>
                        <li><a href="#" class="dropdown-item js-generate-slug-from-title" data-title-input-selector=".js-title-eng-input" data-slug-input-selectpr=".js-slug-input">@Html.Raw(Model.TextTitleEng)</a></li>                        
                    </ul>
                </div>
            </div>
            
            <input type="text" name="@nameof(Model.PageSlug)" class="form-control js-slug-input js-apply-slug-input-behaviour" value="@Html.Raw(Model.PageSlug)" />
            <div class="invalid-feedback"></div>
        </div>
    </div>    
    <div class="row">
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextTitle) *</label>
            <input type="text" name="@nameof(Model.PageTitle)" class="form-control js-title-input" value="@Html.Raw(Model.PageTitle)" />
            <div class="invalid-feedback"></div>
        </div>
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextTitleEng)</label>
            <input type="text" name="@nameof(Model.PageTitleEng)" class="form-control js-title-eng-input" value="@Html.Raw(Model.PageTitleEng)" />
            <div class="invalid-feedback"></div>
        </div>        
    </div>    
    <div class="row">
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextDescriptionShort) <a href="#" class="js-short-description-and-image-info"><i class="fa-solid fa-circle-info"></i></a> </label>
            <textarea name="@nameof(Model.PageShortDescription)" class="form-control" maxlength="300">@Html.Raw(Model.PageShortDescription)</textarea>
        </div>
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextDescriptionShortEng) <a href="#" class="js-short-description-and-image-info"><i class="fa-solid fa-circle-info"></i></a> </label>
            <textarea name="@nameof(Model.PageShortDescriptionEng)" class="form-control" maxlength="300">@Html.Raw(Model.PageShortDescriptionEng)</textarea>
        </div>
    </div>             
</form>

@section FooterSection{
    <script src="/js/admin/pages/page/PagePropertiesView.js"></script>
    <script>
        model.textPageShortDescriptionAndImageInfo = '@Html.Raw(Model.TextPageShortDescriptionAndImageInfo)';
    </script>
    @if (Model.HasFormErrors)
    {
        <script>
        $(function(){
            validation.init({ errorsJson: @Html.Raw(Model.FormErrorsJson)}).showErrors();
        });
        </script>
    }
}