@model ProductCategoryPropertiesModel.ViewModel

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSavePartialView, new ButtonSaveViewModel { FormID = "form", CssClass = "js-show-preloader" })
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <form id="form" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextName) *</label>
                    <input type="text" name="@nameof(Model.ProductCategoryName)" class="form-control" value="@Model.ProductCategoryName" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextNameEng)</label>
                    <input type="text" name="@nameof(Model.ProductCategoryNameEng)" class="form-control" value="@Model.ProductCategoryNameEng" />
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionShort)</label>
                    <textarea type="text" name="@nameof(Model.ProductCategoryDescriptionShort)" rows="7" class="form-control">@Html.Raw(Model.ProductCategoryDescriptionShort)</textarea>
                </div>
                <div class="col-lg-6 form-group">
                    <label>@Html.Raw(Model.TextDescriptionShortEng)</label>
                    <textarea type="text" name="@nameof(Model.ProductCategoryDescriptionShortEng)" rows="7" class="form-control">@Html.Raw(Model.ProductCategoryDescriptionShortEng)</textarea>
                </div>                
            </div>
            <div class="row">
                <div class="col-lg-12 form-group">
                    <label>@Html.Raw(Model.TextUploadImage)</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-custom-file-upload-attachment" data-type="image" href="@Html.Raw(Model.ProductCategoryImageHttpPath)">@Html.Raw(Model.ProductCategoryImageFilename)</a>
                            <span class="js-custom-file-upload-new-attachment hidden"></span>
                        </div>
                        @if (Model.HasProductCategoryImage)
                        {
                            <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-outline-light js-custom-file-upload-delete-button"><i class="fa-light fa-trash-can"></i></button>
                        }
                        <button type="button" class="btn btn-outline-light hidden js-custom-file-upload-clear-button"><i class="fa fa-times"></i></button>
                        <span class="btn btn-outline-light custom-file-upload">
                            <i class="fas fa-folder-open"></i>
                            <input type="file" name="@nameof(Model.ProductCategoryImageFile)" accept="image/*" />
                        </span>
                    </div>                   
                </div>
            </div>
        </form>
    </div>
</div>

@section FooterSection{
    <script src="/js/admin/productCategories/ProductCategoryPropertiesView.js"></script>
    @if (Model.HasErrors)
    {
        @if (Model.HasFormErrors)
        {
            <script>
                validation.init({ errorsJson: @Html.Raw(Model.FormErrorsJson) }).showErrors();
            </script>
        }
        @if (Model.HasToastError)
        {
            <script>
                successErrorToast63Bits.init({isError:true,message:'@Html.Raw(Model.ToastError)'}).showMessage();
            </script>
        }
    }
}