@model MenuFooterModel.ViewModel
@{
    Layout = ViewNames.Admin.Shared.TabsPartial;
}
@section HeaderSection {
    <link href="/css/admin/SortableTree.css" rel="stylesheet" />
}
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                @if (Model.ShowAddNewButton)
                {
                    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonAddNewPartialView, new ButtonAddNewViewModel())
                }
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                <div class="sortable">
                    <ul class="js-tree js-sortable">
                        @if (Model.HasMenuItems)
                        {
                            foreach (var item in Model.MenuItems)
                            {
                                @await Html.PartialAsync(ViewNames.Admin.MenuFooter.MenuFooterTreeNodePartial, item)
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade js-modal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@Html.Raw(Model.TextAdd)</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" class="js-modal-MenuFooterID-hf" />
                <input type="hidden" class="js-modal-MenuFooterParentID-hf" />
                <div class="row">
                    <div class="col form-group d-flex justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input js-modal-MenuFooterIsExternalPage-checkbox" type="checkbox" value="" id="js-modal-MenuFooterIsExternalPage-checkbox" />
                            <label class="form-check-label" for="js-modal-MenuFooterIsExternalPage-checkbox">@Html.Raw(Model.TextPageIsExternal)</label>
                        </div>
                    </div>
                </div>

                <div class="row js-modal-page-components">
                    <div class="col-lg-12 form-group">
                        <label>@Html.Raw(Model.TextPageInternal)</label>
                        <div class="form-control js-modal-PageID-input">
                            @(Html.DevExtreme().SelectBox()
                                .OnInitialized("model.onPagesSelectBoxInitialized")
                                .OnSelectionChanged("model.onPagesSelectBoxSelectionChanged")
                                .DataSource(d => d.Array().Data(Model.Pages))
                                .ValueExpr(Model.SelectBoxValueExpr)
                                .DisplayExpr(Model.SelectBoxDisplayExpr)
                                .ElementAttr("class", "border-0")
                                .SearchEnabled(true)
                                )
                        </div>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <div class="d-flex justify-content-between">
                            <label>@Html.Raw(Model.TextSlug) *</label>
                            <div class="dropdown">
                                <a href="javascript:void(0)" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    @Html.Raw(Model.TextGenerateFromTitle)
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a href="#" class="dropdown-item js-generate-slug-from-title" data-title-input-selector=".js-modal-PageTitle-input" data-slug-input-selectpr=".js-modal-PageSlug-input">@Html.Raw(Model.TextTitle)</a></li>
                                    <li><a href="#" class="dropdown-item js-generate-slug-from-title" data-title-input-selector=".js-modal-PageTitleEng-input" data-slug-input-selectpr=".js-modal-PageSlug-input">@Html.Raw(Model.TextTitleEng)</a></li>                                    
                                </ul>
                            </div>
                        </div>
                        <input type="text" class="form-control js-modal-PageSlug-input" />
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-lg-4 form-group">
                        <label>@Html.Raw(Model.TextTitle) *</label>
                        <input type="text" class="form-control js-modal-PageTitle-input" />
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-lg-4 form-group">
                        <label>@Html.Raw(Model.TextTitleEng)</label>
                        <input type="text" class="form-control js-modal-PageTitleEng-input" />
                    </div>                    
                    <div class="col-lg-4 form-group">
                        <label>@Html.Raw(Model.TextPublished)</label>
                        <label class="toggler toggler-lg">
                            <input type="checkbox" class="js-modal-PageIsPublished-checkbox" />
                            <i></i>
                        </label>
                    </div>
                </div>
                <div class="row hidden js-modal-menu-item-components">
                    <div class="col-lg-12 form-group">
                        <label>@Html.Raw(Model.TextPageExternalUrl) (https://somedomain.com ...)</label>
                        <input type="text" class="form-control js-modal-MenuFooterExternalPageUrl-input" />
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-lg-6 form-group">
                        <label>@Html.Raw(Model.TextTitle) *</label>
                        <input type="text" class="form-control js-modal-MenuFooterTitle-input" />
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-lg-6 form-group">
                        <label>@Html.Raw(Model.TextTitleEng)</label>
                        <input type="text" class="form-control js-modal-MenuFooterTitleEng-input" />
                    </div>                    
                    <div class="col-lg-6 form-group">
                        <label>@Html.Raw(Model.TextPublished)</label>
                        <label class="toggler toggler-lg">
                            <input type="checkbox" class="js-modal-MenuFooterIsPublished-checkbox" />
                            <i></i>
                        </label>
                    </div>
                    <div class="col-lg-6 form-group">
                        <label>@Html.Raw(Model.TextOpenInNewTab)</label>
                        <label class="toggler toggler-lg">
                            <input type="checkbox" class="js-modal-MenuFooterIsTargetBlank-checkbox" />
                            <i></i>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSavePartialView, new ButtonSaveViewModel { JsSelector = "js-modal-save-button" })
            </div>

        </div>
    </div>
</div>


@section FooterSection {
    <script src="/js/admin/menuFooter/MenuFooterView.js"></script>
    <script>
        model.urlAdd = '@Model.UrlAdd';
        model.urlUpdate = '@Model.UrlUpdate';
        model.urlDelete = '@Model.UrlDelete';
        model.urlSort = '@Model.UrlSort';
        model.urlGet = '@Model.UrlGet';
        model.urlGetPage = '@Model.UrlGetPage';
        model.urlGetPages = '@Model.UrlGetPages';
        model.textAdd = '@Html.Raw(Model.TextAdd)';
        model.textUpdate = '@Html.Raw(Model.TextUpdate)';
        model.textConfirmDelete = '@Html.Raw(Model.TextConfirmDelete)';
        model.textConfirmDeleteRecursiveWithTypeDelete = '@Html.Raw(Model.TextConfirmDeleteRecursiveWithTypeDelete)';
    </script>
}
