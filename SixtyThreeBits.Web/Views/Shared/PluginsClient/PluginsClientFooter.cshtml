@model PluginClient
@if (Model.IsBootstrapEnabled)
{
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
}
@if (Model.IsUtilsEnabled)
{
    <script src="~/plugins/utils/utils.js"></script>
}
@if (Model.IsPreloaderEnabled)
{
    <script src="~/plugins/preloader/preloader.js"></script>
}
@if (Model.IsJQueryUIEnabled)
{
    <script src="~/plugins/jquery-ui/jquery-ui.js"></script>
}
@if (Model.IsJQueryConfirmEnabled)
{
    <script src="~/plugins/jquery-confirm/jquery-confirm.min.js"></script>
}
@if (Model.IsJQueryNestedSortableEnabled)
{
    <script src="~/plugins/jquery-nestedSortable/jquery.mjs.nestedSortable.js"></script>
}
@if (Model.Is63BitsComponentsEnabled)
{
    <script src="~/plugins/63bits-components/63bits-components.js"></script>
}
@if (Model.IsFancyboxEnabled)
{
    <script src="~/plugins/fancybox/jquery.fancybox.js"></script>
    <script src="~/plugins/fancybox/FancyMethods.js"></script>
}
@if (Model.Is63BitsFormsEnabled)
{
    <script src="~/plugins/63bits-bsforms/63bits-bsforms.js"></script>
}
@if (Model.IsPreloaderEnabled)
{
    <script src="~/plugins/preloader/preloader.js"></script>
}
@if (Model.IsSelect2Enabled)
{
    <script src="~/plugins/select2/js/select2.full.min.js"></script>
}
@if(Model.IsTemplate7Enabled)
{
    <script src="~/plugins/template7/template7.min.js"></script>
}
@if (Model.IsJsZipEnabled)
{
    <script src="~/plugins/jszip/jszip.min.js"></script>
}
@if (Model.IsDataTablesEnabled)
{
    <script src="~/plugins/datatables/datatables.min.js"></script>
    <script src="~/plugins/datatables/DataTables-1.10.20/js/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/DataTables-1.10.20/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/Buttons-1.6.1/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables/Buttons-1.6.1/js/buttons.foundation.min.js"></script>
    <script src="~/plugins/datatables/Buttons-1.6.1/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/Buttons-1.6.1/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables/Buttons-1.6.1/js/buttons.print.min.js"></script>
}