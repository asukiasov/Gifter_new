@{ 
    var Model = LocalUtilities.GetLayoutViewModel<AdminLayoutViewModel>(ViewData: ViewData, Key: Constants.ViewData.LayoutViewModel); 
    Layout = Model.TabsLayoutViewName;
}

@section HeaderSection{
    <link href="~/admin/css/Tabs.css" rel="stylesheet" />
    @RenderSection(Constants.ViewSections.HeaderSection, false)
}

<ul class="nav nav-tabs">
    @if (Model.HasTabs)
    {
        foreach (var Item in Model.Tabs)
        {
            <li class="nav-item">
                <a class="nav-link submenu-nav-link @(Item.IsSelected ? Html.Raw("active") : null)" @(Item.IsSelected ? null : Html.Raw($"href=\"{Item.NavigateUrl}\""))>@Html.Raw(Item.Caption)</a>
            </li>
        }
    }

</ul>

<div class="tab-content">    
    @RenderBody()
</div>

@section FooterSection{
    @RenderSection(Constants.ViewSections.FooterSection, false)
}
