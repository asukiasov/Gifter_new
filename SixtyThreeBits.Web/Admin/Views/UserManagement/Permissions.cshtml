@model PermissionsModel.PageViewModel
@if (Model.ShowAddNewButton)
{
    <div class="actions-row">
        @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonAddNew, new ButtonAddNewViewModel())
    </div>
}
<div class="row">
    <div class="col">
        @Model.Tree.Render(Html)
    </div>
</div>
@section FooterSection{
    <script src="~/admin/js/UserManagement/Permissions.js"></script>
    <script>
    PermissionsModel.UrlUpdate = '@Model.UrlUpdate';
    </script>
}