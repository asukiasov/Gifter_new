@model RolePermissionsModel.PageViewModel
@if (Model.ShowSaveButton)
{
<div class="actions-row">
    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel())
</div>
}
<div class="row">
    <div class="col-xl-4">
        <div class="card mb-0">
            <div class="panel-body">                
                @Model.RolesGrid.Render(Html)
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card mb-0">
            <div class="panel-body">                
                @Model.PermissionsTree.Render(Html)
            </div>
        </div>
    </div>
</div>
@section FooterSection{
<script src="~/admin/js/UserManagement/RolePermissions.js"></script>    
<script>
    RolePermissionsModel.UrlSave = '@Html.Raw(Model.UrlSave)';
    RolePermissionsModel.UrlGetRolePermissions = '@Html.Raw(Model.UrlGetRolePermissions)';
</script>
}
