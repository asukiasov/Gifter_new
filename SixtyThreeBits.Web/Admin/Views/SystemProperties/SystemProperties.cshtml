@model SystemPropertiesModel.PageViewModel 
@section HeaderSection{
}
<div class="actions-row">
    <button type="submit" class="btn btn-circle btn-primary js-save-button" form="SystemPropertiesForm"><i class="fas fa-save"></i></button>
</div>
<div class="card">
    <div class="card-body">
        <form id="SystemPropertiesForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>Contact Phone</label>
                    <input type="text" name="@nameof(Model.ContactPhone)" class="form-control" value="@Model.ContactPhone" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>Contact Email</label>
                    <input type="text" name="@nameof(Model.ContactEmail)" class="form-control" value="@Model.ContactEmail" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>Contact Address</label>
                    <input type="text" name="@nameof(Model.ContactAddress)" class="form-control" value="@Model.ContactAddress" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>Facebook Url</label>
                    <input type="text" name="@nameof(Model.FacebookUrl)" class="form-control" value="@Html.Raw(Model.FacebookUrl)" />
                </div>
                <div class="form-group col-lg-4">
                    <label>Instagram Url</label>
                    <input type="text" name="@nameof(Model.InstagramUrl)" class="form-control" value="@Html.Raw(Model.InstagramUrl)" />
                </div>
                <div class="form-group col-lg-4">
                    <label>Twitter Url</label>
                    <input type="text" name="@nameof(Model.TwitterUrl)" class="form-control" value="@Html.Raw(Model.TwitterUrl)" />
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>Youtube Url</label>
                    <input type="text" name="@nameof(Model.YoutubeUrl)" class="form-control" value="@Html.Raw(Model.YoutubeUrl)" />
                </div>
                <div class="form-group col-lg-4">
                    <label>LinkedIn Url</label>
                    <input type="text" name="@nameof(Model.LinkedInUrl)" class="form-control" value="@Html.Raw(Model.LinkedInUrl)" />
                </div>
                <div class="form-group col-lg-4">

                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>Google iFrame <a href="/img/google-maps-iframe-help.png" class="js-google-iframe-help"><i class="fas fa-question-circle"></i></a></label>
                    <textarea name="@nameof(Model.GoogleMapsIFrame)" class="form-control">@Html.Raw(Model.GoogleMapsIFrame)</textarea>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-12">                    
                    @Html.Raw(Model.GoogleMapsIFrame)
                </div>
            </div>
        </form>
    </div>
</div>

@section FooterSection{
    <script src="~/admin/js/SystemProperties/SystemProperties.js"></script>        
}
