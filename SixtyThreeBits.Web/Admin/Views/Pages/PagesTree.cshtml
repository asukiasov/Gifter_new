@model PagesTreeModel.PageViewModel

@section HeaderSection{
    <link href="~/admin/css/SortableTree.css" rel="stylesheet" />
}

@if (Model.ShowAddNewButton)
{
    <div class="actions-row">
        <button class="btn btn-oval btn-default js-show-create-new-page-modal-button"><i class="fas fa-plus"></i> <span>Add</span></button>
    </div>
}
<div class="row">
    <div class="col-12">
        @await Html.PartialAsync(ViewNames.Admin.Shared.FileTreeEditor.Editor, Model.Pages)
    </div>
</div>

@section FooterSection{
    <div class="modal fade js-create-new-page-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Add New Page</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col form-group">
                            <label>Page Title</label>
                            <input type="text" class="form-control js-page-title-textbox" />
                            <input type="hidden" class="js-page-parent-id-hf" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-circle btn-primary js-create-new-page-button"><i class="fas fa-save"></i></button>
                </div>

            </div>
        </div>
    </div>

    <script src="~/admin/js/Pages/PagesTree.js"></script>    
    <script>
    PagesTreeModel.UrlCreateNew = '@Model.UrlCreateNew';
    PagesTreeModel.UrlUpdate = '@Model.UrlUpdate';
    PagesTreeModel.UrlDelete = '@Model.UrlDelete';
    PagesTreeModel.UrlSyncParentsAndSortIndexes = '@Model.UrlSyncParentsAndSortIndexes';
    PagesTreeModel.TextConfirmDeleteRecord = '@Model.TextConfirmDeleteRecord';
    PagesTreeModel.TextConfirmDeleteRecursive = '@Model.TextConfirmDeleteRecursive';
    PagesTreeModel.ValidationRequiredPageTitle = '@Model.ValidationRequired';
    </script>    
}