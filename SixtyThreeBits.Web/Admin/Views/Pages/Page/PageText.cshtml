@model PageModel.PageBuilderViewModel
@{ Layout = null; }
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="icon" type="image/png" href="~/Content/Images/favicon.png">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    <title>@Model.PageTitle | Page Text</title>
    @await Html.PartialAsync(ViewNames.Shared.PluginsClient.Header, Model.PluginsClient)
    <link href="~/css/style.css" rel="stylesheet" />
</head>

<body>

    <header class="editor-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center left-col">
            <div class="">
                <a href="@Model.UrlBack" class="editor-btn-rounded" data-toggle="tooltip" data-placement="right" title="Back"><img src="/plugins/63bits-pageBuilder/images/icons/back.svg" alt="Back" /></a>
            </div>
            <div class="form-inline">
                <div class="form-group">
                    <label>Page Title:</label>
                    <div>
                        <input class="form-control js-page-name-input" type="text" name="PageTitle" placeholder="Page name" value="@Html.Raw(Model.PageTitle)" />
                        <div class="tooltip bs-tooltip-bottom error-tooltip">
                            <div class="tooltip-inner">Error Text</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Slug:</label>
                    <div>
                        <input class="form-control js-page-slug-input" type="text" name="PageSlug" placeholder="Page slug" value="@Html.Raw(Model.PageSlug)" />
                        <div class="tooltip bs-tooltip-bottom error-tooltip">
                            <div class="tooltip-inner">Error Text</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center right-col">
            <label class="toggler">
                <span>Publish</span>
                <input type="checkbox" name="IsPublished" @(Model.IsPublished ? Html.Raw("checked") : null) />
                <i></i>
            </label>

            <div class="editor-lang-wrap dropdown">
                <button class="editor-btn-rounded" data-toggle="dropdown" data-display="static" aria-expanded="false"><span class="js-current-lang-short-name">@Model.SelectedLanguage</span></button>
                <div class="dropdown-menu">
                    @if (Model.HasLanguageOptions)
                    {
                        <ul>
                            @foreach (var Item in Model.LanguageOptions)
                            {
                                if (!Item.IsSelected)
                                {
                                    <li>
                                        <a href="@Html.Raw(Item.Value)">@Item.Key</a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </div>
            </div>

            <a href="@Html.Raw(Model.UrlPreview)" target="_blank" class="editor-btn-rounded" data-toggle="tooltip" data-placement="left" title="Preview"><img src="/plugins/63bits-pageBuilder/images/icons/eye.svg" alt="preview"></a>

            <button class="editor-btn-rounded bg-green js-save-btn" data-toggle="tooltip" data-placement="left" title="Save">
                <img class="js-save-img" src="/plugins/63bits-pageBuilder/images/icons/save_white.svg" alt="save icon">
                <img class="js-loader-img hidden" src="/plugins/63bits-pageBuilder/images/icons/loader_white.svg" alt="loader icon">
                <img class="js-success-img hidden" src="/plugins/63bits-pageBuilder/images/icons/done_white.svg" alt="success icon">
            </button>
        </div>
    </header>

    <div class="editor-sections-builder js-builder">
        <div class="wrap">
            <button class="editor-btn-rounded close-btn js-close-builder hidden"><img src="/plugins/63bits-pageBuilder/images/icons/close.svg" alt="close icon"></button>

            <div class="page-items-container js-page-items hidden">
                <ul></ul>
            </div>

            <div class="add-btn-row">
                <button class="btn js-show-new-items-container">Add</button>
            </div>
        </div>

        <div class="new-items-container js-new-items hidden">
            <button class="editor-btn-rounded close-btn js-close-new-items-container"><img src="/plugins/63bits-pageBuilder/images/icons/close.svg" alt="close icon"></button>

            <h5>Choose From</h5>

            <ul>
                <li class="editor-sections-builder-item js-builder-item" data-item="slide" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_img_1.svg" alt="photo + text">
                        <span class="name js-builder-item-name">Photo+Text</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="slider" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_img_1.svg" alt="slider">
                        <span class="name js-builder-item-name">slider</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="article2ColWithImg" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_text_img.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Text+Photo</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="article2ColWithImg" data-type="2">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_img_text.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Photo+Text</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="article2ColWithImg" data-type="3">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_text_img_sm.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Text+Photo small</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="article2ColWithImg" data-type="4">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_img_text_sm.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Photo small+Text</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="article" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_title_text.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Text</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="article2Col" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_title_text_title_text.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Text+Text</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="articleText2Col" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_title_text_text.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Title+Text2col</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="articleWithFiles" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_uploads.svg" alt="download files">
                        <span class="name js-builder-item-name">File download</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="video" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_video.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Video</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="articleWithVideo" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_video.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Video + text</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>

                <li class="editor-sections-builder-item js-builder-item" data-item="articlesGrid" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_articles_grid.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">articles grid</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="articlesList" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_articles_list.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">articles list</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="imgGrid" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_img_grid.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">img grid</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="services" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_services.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Services</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="testimonials" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_testimonials.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Testimonials</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="faq" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_faq.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">FAQ</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
                <li class="editor-sections-builder-item js-builder-item" data-item="html" data-type="1">
                    <div>
                        <i class="handle js-builder-item-handle"><img src="/plugins/63bits-pageBuilder/images/icons/drug.svg" alt="drag icon"></i>
                        <img class="thumb" src="/plugins/63bits-pageBuilder/images/icons/builder/bl_html.svg" alt="photo + text center">
                        <span class="name js-builder-item-name">Html</span>
                    </div>
                    <div class="controls">
                        <button class="js-delete-section"><img src="/plugins/63bits-pageBuilder/images/icons/remove.svg" alt="remove"></button>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <main class="page editor-page js-editor-page">
        @Html.Raw(Model.PageText)
    </main>
    @await Html.PartialAsync(ViewNames.Shared.PluginsClient.Footer, Model.PluginsClient)
    <script src="/admin/js/Pages/Page/PageText.js"></script>
    <script>
        PageBuilderModel.urlSave = '@Model.UrlSave';
        PageBuilderModel.textError = '@Model.TextError';
        PageBuilderModel.language = '@Model.Language';
        PageBuilderModel.urlFileManager = '@Html.Raw(Model.UrlFileManager)';        
    </script>
</body>
</html>