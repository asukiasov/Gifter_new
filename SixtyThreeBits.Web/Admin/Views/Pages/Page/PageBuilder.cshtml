@model PageModel.PageBuilderViewModel
@{ Layout = null; }
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="icon" type="image/png" href="~/Content/Images/favicon.png">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    <title>@Model.PageTitle | Editor</title>
    @await Html.PartialAsync(ViewNames.Shared.PluginsClient.Header, Model.PluginsClient)
</head>

<body>

    <header class="editor-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center left-col">
            <div class="">
                <a href="@Model.UrlBack" class="editor-btn-rounded" data-toggle="tooltip" data-placement="right" title="Back"><img src="/plugins/63bits-pageBuilder/images/icons/back.svg" alt="Back" /></a>
            </div>
            <div class="form-inline">
                <div class="form-group">
                    <label>Page Title:</label>
                    <div>
                        <input class="form-control js-page-name-input" type="text" name="PageTitle" placeholder="Page name" value="@Html.Raw(Model.PageTitle)" />
                        <div class="tooltip bs-tooltip-bottom error-tooltip">
                            <div class="tooltip-inner">Error Text</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center right-col">

            <div class="editor-lang-wrap dropdown">
                <button class="editor-btn-rounded" data-toggle="dropdown" data-display="static" aria-expanded="false"><span class="js-current-lang-short-name">@Model.SelectedLanguage</span></button>
                <div class="dropdown-menu">
                    @if (Model.HasLanguageOptions)
                    {
                        <ul>
                            @foreach (var Item in Model.LanguageOptions)
                            {
                                if (!Item.IsSelected)
                                {
                                    <li>
                                        <a href="@Html.Raw(Item.Value)">@Item.Key</a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </div>
            </div>

            <button class="editor-btn-rounded js-show-filemanager-popup-btn" data-toggle="tooltip" data-placement="bottom" title="Upload files"><img src="/plugins/63bits-pageBuilder/images/icons/upload.svg" alt="filemanager"></button>

            <button class="editor-btn-rounded js-show-page-scripts-popup-btn" data-toggle="tooltip" data-placement="bottom" title="Add custom Styles & Scripts"><img src="/plugins/63bits-pageBuilder/images/icons/settings.svg" alt="settings"></button>

            <a href="@Html.Raw(Model.UrlPreview)" target="_blank" class="editor-btn-rounded" data-toggle="tooltip" data-placement="left" title="Preview"><img src="/plugins/63bits-pageBuilder/images/icons/eye.svg" alt="preview"></a>

            <button class="editor-btn-rounded bg-green js-save-btn" data-toggle="tooltip" data-placement="left" title="Save">
                <img class="js-save-img" src="/plugins/63bits-pageBuilder/images/icons/save_white.svg" alt="save icon">
                <img class="js-loader-img hidden" src="/plugins/63bits-pageBuilder/images/icons/loader_white.svg" alt="loader icon">
                <img class="js-success-img hidden" src="/plugins/63bits-pageBuilder/images/icons/done_white.svg" alt="success icon">
            </button>

            <button class="editor-btn-rounded js-editor-sidebar-toggle-btn">
                <span class="hamburger"><span></span></span>
            </button>
        </div>
    </header>

    <div class="editor-sections-builder js-builder">
        <div class="wrap">
            <button class="editor-btn-rounded close-btn js-close-builder hidden"><img src="/plugins/63bits-pageBuilder/images/icons/close.svg" alt="close icon"></button>

            <div class="page-items-container js-page-items hidden">
                <ul></ul>
            </div>

            <div class="add-btn-row">
                <button class="btn js-show-new-items-container">Add</button>
            </div>
