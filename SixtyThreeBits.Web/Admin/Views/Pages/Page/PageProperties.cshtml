@model PagePropertiesModel.PageViewModel    
@section HeaderSection{
}


<form method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col">
            @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel {CssClass = "js-show-preloader"})
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="form-group col-lg-2">
            <label>@Html.Raw(Model.TextPublished)</label>
            <label class="toggler toggler-lg">
                <input type="checkbox" id="IsPublishedChechBox" name="@nameof(Model.PageIsPublished)" value="true" @(Model.PageIsPublished ? Html.Raw("checked") : null) />
                <i></i>
            </label>
        </div>
        <div class="form-group col-lg-2">
            <label>@Html.Raw(Model.TextMenu)</label>
            <label class="toggler toggler-lg">
                <input type="checkbox" id="IsMenuItemChechBox" name="@nameof(Model.PageIsMenuItem)" value="true" @(Model.PageIsMenuItem ? Html.Raw("checked") : null) />
                <i></i>
            </label>
        </div>
        <div class="form-group col-lg-2">
            <label>@Html.Raw(Model.TextFooter)</label>
            <label class="toggler toggler-lg">
                <input type="checkbox" id="IsMenuItemChechBox" name="@nameof(Model.PageIsFooterItem)" value="true" @(Model.PageIsFooterItem ? Html.Raw("checked") : null) />
                <i></i>
            </label>
        </div>
        <div class="form-group col-lg-6">                    
            <label>@Html.Raw(Model.TextUploadImage)</label>
            <div class="input-group custom-file-group js-custom-file-upload">
                <div class="form-control">
                    <a class="js-custom-file-upload-attachment" data-type="image" href="@Model.PageImageHttpPath">@Model.PageImageFilename</a>
                    <span class="js-custom-file-upload-new-attachment hidden"></span>
                </div>
                @if (Model.HasPageImage)
                {                
                    <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-outline-light js-custom-file-upload-delete-button"><i class="fa-light fa-trash-can"></i></button>
                }                
                <button type="button" class="btn btn-outline-light hidden js-custom-file-upload-clear-button"><i class="fa fa-times"></i></button>                
                <span class="btn btn-outline-light custom-file-upload">
                    <i class="fas fa-folder-open"></i>
                    <input type="file" name="@nameof(Model.PageImageFile)" accept="image/*" />
                </span>                
            </div>
        </div>
    </div>
    <div class="row">
        <div class="form-group col-lg-6">
            <label class="d-flex justify-content-between">
                <span>@Html.Raw(Model.TextSlug) *</span>
                <a href="#" class="js-generate-slug-from-title" data-title-input-selector=".js-title-input" data-slug-input-selectpr=".js-slug-input">@Html.Raw(Model.TextGenerateFromTitle)</a>
            </label>
            <input type="text" name="@nameof(Model.PageSlug)" class="form-control js-slug-input js-apply-slug-input-behaviour" value="@Html.Raw(Model.PageSlug)" />            
            <div class="invalid-feedback"></div>
        </div>
        <div class="form-group col-lg-6">
            <div class="d-flex justify-content-between">
                <label>@Html.Raw(Model.TextPageUrl)</label>
                <div class="form-check">
                    <input type="checkbox" name="@(nameof(Model.PageIsExternalUrl))" class="form-check-input js-is-external-url-checkbox" id="js-is-external-url-checkbox" value="true" @(Model.PageIsExternalUrl ? Html.Raw("checked") : null) />
                    <label class="form-check-label" for="js-is-external-url-checkbox">@Html.Raw(Model.TextExternalPage)</label>
                </div>                
            </div>            
            <input type="text" name="@nameof(Model.PageExternalUrl)" class="form-control js-external-url-input" value="@Html.Raw(Model.PageExternalUrl)" />
            <div class="invalid-feedback"></div>
        </div>
    </div>
    <div class="row">
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextTitle) *</label>
            <input type="text" name="@nameof(Model.PageTitle)" class="form-control js-title-input" value="@Html.Raw(Model.PageTitle)" />
            <div class="invalid-feedback"></div>
        </div>
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextTitleEng)</label>
            <input type="text" name="@nameof(Model.PageTitleEng)" class="form-control" value="@Html.Raw(Model.PageTitleEng)" />
            <div class="invalid-feedback"></div>
        </div>        
    </div>
    <div class="row">
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextDescriptionShort)</label>
            <textarea name="@nameof(Model.PageShortDescription)" class="form-control" maxlength="200">@Html.Raw(Model.PageShortDescription)</textarea>
        </div>
        <div class="form-group col-lg-6">
            <label>@Html.Raw(Model.TextDescriptionShortEng)</label>
            <textarea name="@nameof(Model.PageShortDescriptionEng)" class="form-control" maxlength="200">@Html.Raw(Model.PageShortDescriptionEng)</textarea>
        </div>        
    </div>             
</form>
    

@section FooterSection{
    <script src="~/admin/js/Pages/Page/PageProperties.js"></script>    
    @if (Model.HasErrors)
    {
        <script>
        $(function(){
            validation.init({ errorsJson: @Html.Raw(Model.ErrorsJson)}).showErrors();
        });
        </script>
    }

}