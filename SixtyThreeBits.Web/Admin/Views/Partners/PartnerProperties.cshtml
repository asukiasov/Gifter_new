@model PartnerPropertiesModel.PartnerPropertiesViewModel
<div class="actions-row">
    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel { FormID = "PartnersDetailForm" })
</div>
<div class="card">
    <div class="card-body">
        <form id="PartnersDetailForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის სახელი</label>
                    <input value="@Model.PartnerName" name="@nameof(Model.PartnerName)" class="form-control js-partner-name" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის სახელი (ინგლისურად)</label>
                    <input value="@Model.PartnerNameEng" name="@nameof(Model.PartnerNameEng)" type="text" class="form-control js-partner-name-eng" />
                </div>
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის სახელი (რუსულად)</label>
                    <input name="@nameof(Model.PartnernameRus)" value="@Model.PartnernameRus" type="text" class="form-control js-partner-name-rus" />
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის მოკლე აღწერა</label>
                    <textarea name="@nameof(Model.PartnerShortDescription)" class="form-control js-partner-short-description">@Model.PartnerShortDescription</textarea>
                </div>
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის მოკლე აღაწერა (ინგლისურად)</label>
                    <textarea name="@nameof(Model.PartnerShortDescriptionEng)" class="form-control js-partner-short-description-eng">@Model.PartnerShortDescriptionEng</textarea>
                </div>
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის მოკლე აღწერა (რუსულად)</label>
                    <textarea name="@nameof(Model.PartnerShortDescriptionRus)" class="form-control js-partner-short-description-rus">@Model.PartnerShortDescriptionRus</textarea>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის სრული აღწერა</label>
                    <textarea name="@nameof(Model.PartnerFullDescription)" class="form-control js-partner-full-description">@Model.PartnerFullDescription</textarea>
                </div>
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის სრული აღწერა (ინგლისურად)</label>
                    <textarea name="@nameof(Model.PartnerFullDescriptionEng)" class="form-control js-partner-full-description-eng">@Model.PartnerFullDescriptionEng</textarea>
                </div>
                <div class="col-lg-4 form-group">
                    <label>პარტნიორის სრული აღწერა (რუსულად)</label>
                    <textarea name="@nameof(Model.PartnerFullDescriptionRus)" class="form-control js-partner-full-description-rus">@Model.PartnerFullDescriptionRus</textarea>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 form-group">
                    <label class="mb-0">პარტნიორის ვებ საიტის URL</label>
                    <input name="@nameof(Model.PartnerWebSite)" value="@Model.PartnerWebSite" type="text" class="form-control js-partner-website-url" />
                </div>
                <div class="form-group col-lg-6">
                    <label class="mb-0">პარტნიორის ფოტოსურათი</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-attachment js-image-attachment" href="@Html.Raw(Model.PartnerImageHttpPath)">@Html.Raw(Model.PartnerImageFilename)</a>
                            <span class="js-new-attachment hidden"></span>
                        </div>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                            @if (Model.ShowPartnerImageDeleteButton)
                            {
                                <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Model.TextConfirmDelete" class="btn btn-danger js-delete-button"><i class="fas fa-trash-alt"></i></button>
                            }
                            <span class="btn btn-default custom-file-upload">
                                <i class="fas fa-folder-open"></i>
                                <input type="file" name="PostedFile" accept="image/*" />
                            </span>
                        </span>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section FooterSection{
    <script src="~/admin/js/Partners/PartnerProperties.js"></script>
    @if (Model.HasErrors)
    {
                    <script>
        Validation.Init({ ErrorsJson: @Html.Raw(Model.ErrorsJson)}).ShowErrors();
                    </script>

}
}