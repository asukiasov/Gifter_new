@model BlogPropertiesModel.BlogPropertiesViewModel
<div class="actions-row">
    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel { FormID = "BlogDetailsForm" })    
</div>
<div class="card">
    <div class="card-body">
        <form id="BlogDetailsForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="form-group col-lg-6">
                    <label>Published?</label>
                    <label class="toggler toggler-lg">
                        <input type="checkbox" name="@nameof(Model.BlogPostIsPublished)" value="true" @(Model.BlogPostIsPublished ? Html.Raw("checked") : null) />
                        <i></i>
                    </label>
                </div>
                <div class="form-group col-lg-6">
                    <label>Upload Image</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-attachment js-image-attachment" href="@Html.Raw(Model.BlogPostImageHttpPath)">@Html.Raw(Model.BlogPostImageFilename)</a>
                            <span class="js-new-attachment hidden"></span>
                        </div>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                            @if (Model.HasBlogPostImage)
                            {
                                <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-danger js-delete-button"><i class="fas fa-trash-alt"></i></button>
                            }
                            <span class="btn btn-default custom-file-upload">
                                <i class="fas fa-folder-open"></i>
                                <input type="file" name="@nameof(Model.PostedFile)" accept="" />
                            </span>
                        </span>
                    </div>
                    <span class="help-block"></span>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-6">
                    <label>Blog Title</label>
                    <div class="input-group">
                        <input type="text" name="@nameof(Model.BlogPostTitle)" class="form-control js-blog-post-title-textbox" value="@Model.BlogPostTitle" />
                        <div class="input-group-append">
                            <button class="btn btn-primary js-slugfy-button" type="button">Slugfy <i class="fas fa-arrow-right"></i></button>
                        </div>
                    </div>
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-6">
                    <label>Blog Slug</label>
                    <input type="text" name="@nameof(Model.BlogPostSlug)" class="form-control js-blog-post-slug-textbox" value="@Model.BlogPostSlug" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-6">
                    <label>Blog Author Name</label>
                    <input type="text" name="@nameof(Model.BlogPostAuthorName)" class="form-control" value="@Model.BlogPostAuthorName" />
                </div>
                <div class="form-group col-lg-6">
                    <label>Blog Date</label>
                    @(Html.DevExtreme().DateBox()
                        .ElementAttr("class", "form-control")
                        .Name(nameof(Model.BlogPostDate))
                        .Value(Model.BlogPostDate)
                        .Type(DateBoxType.Date)
                        .DisplayFormat(Constants.Formats.Date)
                        .Height(34))
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>                
            </div>
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>Blog Text</label>
                    <textarea name="@nameof(Model.BlogPostShortText)" class="form-control" rows="4">@Html.Raw(Model.BlogPostShortText)</textarea>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>Blog Text</label>
                    <textarea name="@nameof(Model.BlogPostText)" class="form-control js-apply-tinymce">@Html.Raw(Model.BlogPostText)</textarea>
                </div>
            </div>
        </form>

    </div>
</div>
@section FooterSection{
    <script src="~/admin/js/Blog/BlogItem.js"></script>
    @if (Model.HasErrors)
    {
        <script>
            Validation.Init({ErrorsJson:@Html.Raw(Model.ErrorsJson)}).ShowErrors();
        </script>
    }
}