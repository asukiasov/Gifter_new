@model NewsPropertiesModel.NewsPropertiesViewModel
<div class="actions-row">
    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel { FormID = "NewsDetailsForm" })
</div>
<div class="card">
    <div class="card-body">
        <form id="NewsDetailsForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>Published?</label>
                    <label class="toggler toggler-lg">
                        <input type="checkbox" name="@nameof(Model.NewsIsPublished)" value="true" @(Model.NewsIsPublished ? Html.Raw("checked") : null) />
                        <i></i>
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>News Slug</label>
                    <input type="text" name="@nameof(Model.NewsSlug)" class="form-control js-slug-textbox" value="@Model.NewsSlug" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>News Date</label>
                    @(Html.DevExtreme().DateBox()
                        .ElementAttr("class", "form-control")
                        .Name(nameof(Model.NewsDatePublished))
                        .Value(Model.NewsDatePublished)
                        .Type(DateBoxType.Date)
                        .DisplayFormat(Constants.Formats.Date)
                        .Height(34))
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>Upload Image</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-attachment js-image-attachment" href="@Html.Raw(Model.NewsImageHttpPath)">@Html.Raw(Model.NewsImageFilename)</a>
                            <span class="js-new-attachment hidden"></span>
                        </div>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                            @if (Model.HasNewsImage)
                            {
                                <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-danger js-delete-button"><i class="fas fa-trash-alt"></i></button>
                            }
                            <span class="btn btn-default custom-file-upload">
                                <i class="fas fa-folder-open"></i>
                                <input type="file" name="PostedFile" accept="" />
                            </span>
                        </span>
                    </div>
                    <span class="help-block"></span>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>Title</label>
                    <input type="text" name="@nameof(Model.NewsTitle)" class="form-control" value="@Model.NewsTitle" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>Title Eng</label>
                    <input type="text" name="@nameof(Model.NewsTitleEng)" class="form-control" value="@Model.NewsTitleEng" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>Title Rus</label>
                    <input type="text" name="@nameof(Model.NewsTitleRus)" class="form-control" value="@Model.NewsTitleRus" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>Short Text</label>
                    <textarea name="@nameof(Model.NewsShortDescription)" class="form-control" rows="3">@Html.Raw(Model.NewsShortDescription)</textarea>
                </div>
                <div class="form-group col-lg-4">
                    <label>Short Text Eng</label>
                    <textarea name="@nameof(Model.NewsShortDescriptionEng)" class="form-control" rows="3">@Html.Raw(Model.NewsShortDescriptionEng)</textarea>
                </div>
                <div class="form-group col-lg-4">
                    <label>Short Text Rus</label>
                    <textarea name="@nameof(Model.NewsShortDescriptionRus)" class="form-control" rows="3">@Html.Raw(Model.NewsShortDescriptionRus)</textarea>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>News Text</label>
                    <textarea name="@nameof(Model.NewsText)" class="form-control js-apply-tinymce">@Html.Raw(Model.NewsText)</textarea>
                </div>
                <div class="form-group col-lg-4">
                    <label>News Text</label>
                    <textarea name="@nameof(Model.NewsTextEng)" class="form-control js-apply-tinymce">@Html.Raw(Model.NewsTextEng)</textarea>
                </div>
                <div class="form-group col-lg-4">
                    <label>News Text</label>
                    <textarea name="@nameof(Model.NewsTextRus)" class="form-control js-apply-tinymce">@Html.Raw(Model.NewsTextRus)</textarea>
                </div>
            </div>
        </form>

    </div>
</div>
@section FooterSection{
    <script src="~/admin/js/News/NewsItem.js"></script>
    <script>
        NewsItemModel.UrlFileManager = '@Html.Raw(Model.UrlFileManager)';
    </script>
    @if (Model.HasErrors)
    {
        <script>
            Validation.Init({ErrorsJson:@Html.Raw(Model.ErrorsJson)}).ShowErrors();
        </script>
    }
}