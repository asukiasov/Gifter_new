@model NewsModel.PageViewModel
@if (Model.ShowAddNewButton)
{
    <div class="actions-row">
        @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonAddNew, new ButtonAddNewViewModel())
    </div>
}
<div class="row">
    <div class="col">
        @Model.Grid.Render(Html)
    </div>
</div>
@section FooterSection{
    <script src="~/admin/js/News/News.js"></script>
}