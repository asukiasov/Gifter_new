@model TeamMemberPropertiesModel.TeamMembersPropertiesViewModel
<div class="actions-row">
    @await Html.PartialAsync(ViewNames.Admin.Shared.ButtonSave, new ButtonSaveViewModel { FormID = "TeamMemberDetailsForm" })
</div>
<div class="card">
    <div class="card-body">
        <form id="TeamMemberDetailsForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="form-group col-lg-3">
                    <label>გამოქვეყნებულია?</label>
                    <label class="toggler toggler-lg">
                        <input type="checkbox" name="@nameof(Model.TeamMemberIsPublished)" value="true" @(Model.TeamMemberIsPublished ? Html.Raw("checked") : null) />
                        <i></i>
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-3">
                    <label>სახელი</label>
                    <input name="@nameof(Model.TeamMemberFirstname)" class="form-control" value="@Model.TeamMemberFirstname" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-3">
                    <label>გვარი</label>
                    <input name="@nameof(Model.TeamMemberLastname)" class="form-control" value="@Model.TeamMemberLastname" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-3">
                    <label>პოზიცია</label>
                    <input name="@nameof(Model.TeamMemberPosition)" class="form-control" value="@Model.TeamMemberPosition" />
                </div>
                <div class="form-group col-lg-3">
                    <label>კატეგორია</label>
                    <select name="@nameof(Model.TeamMemberCategoryID)" class="form-control">
                        <option value="@Constants.NullValueFor.Int"></option>

                        @if (Model.HasTeamMemberCategories)
                        {
                            @foreach (var TeamMemberCategory in Model.TeamMemberCategories)
                            {
                                <option selected="@TeamMemberCategory.IsSelected" value="@TeamMemberCategory.Key">@TeamMemberCategory.Value</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>სურათის ატვირთვა</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-attachment js-image-attachment" href="@Html.Raw(Model.TeamMemberImageHttpPath)">@Html.Raw(Model.TeamMemberImageFilename)</a>
                            <span class="js-new-attachment hidden"></span>
                        </div>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                            @if (Model.HasTeamMemberImage)
                            {
                                <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-danger js-delete-button"><i class="fas fa-trash-alt"></i></button>
                            }
                            <span class="btn btn-default custom-file-upload">
                                <i class="fas fa-folder-open"></i>
                                <input type="file" name="@nameof(Model.TeamMemberImageFile)" accept="image/*" />
                            </span>
                        </span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-sm-12">
                    <label>მოკლე აღწერა</label>
                    <textarea name="@nameof(Model.TeamMemberShortDescription)" class="form-control">@Model.TeamMemberShortDescription</textarea>
                </div>
                <span class="help-block"></span>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <label>სრული აღწერა</label>
                    <textarea name="@nameof(Model.TeamMemberLongDescription)" class="form-control js-apply-tinymce">@Model.TeamMemberLongDescription</textarea>
                </div>
            </div>
        </form>
    </div>
</div>

@section FooterSection{
    <script src="~/admin/js/TeamMembers/TeamMember.js"></script>
    @if (Model.HasErrors)
    {
        <script>
            Validation.Init({ErrorsJson: @Html.Raw(Model.ErrorsJson)}).ShowErrors();
        </script>
    }
}