@model BrandsPropertiesModel.BrandsPropertiesViewModel

<div class="actions-row">
    <button type="submit" class="btn btn-circle btn-primary js-save-button" form="BrandsPropertiesForm"><i class="fas fa-save"></i></button>
</div>

<div class="card">
    <div class="card-body">
        <form id="BrandsPropertiesForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>დასახელება *</label>
                    <input type="text" name="@nameof(Model.BrandName)" class="form-control" value="@Model.BrandName" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>დასახელება ინგლისურად</label>
                    <input type="text" name="@nameof(Model.BrandNameEng)" class="form-control" value="@Model.BrandNameEng" />
                </div>
                <div class="form-group col-lg-4">
                    <label>დასახელება რუსულად</label>
                    <input type="text" name="@nameof(Model.BrandNameRus)" class="form-control" value="@Model.BrandNameRus" />
                </div>
            </div>
            
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>სურათის ატვირთვა</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-attachment js-image-attachment" href="@Html.Raw(Model.BrandImageHttpPath)">@Html.Raw(Model.BrandImageFilename)</a>
                            <span class="js-new-attachment hidden"></span>
                        </div>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                            @if (Model.HasBrandImage)
                            {
                                <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-danger js-delete-button"><i class="fas fa-trash-alt"></i></button>
                            }
                            <span class="btn btn-default custom-file-upload">
                                <i class="fas fa-folder-open"></i>
                                <input type="file" name="PostedFile" accept="" />
                            </span>
                        </span>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section FooterSection{
    <script src="~/admin/js/Brands/BrandItem.js"></script>
    @if (Model.HasErrors)
    {
        <script>
            Validation.Init({ErrorsJson:@Html.Raw(Model.ErrorsJson)}).ShowErrors();
        </script>
    }
}
