@model AuthModel.LoginPageViewModel
@{ Layout = null;}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>Login | @Html.Raw(Model.ProjectName)</title>
    @await Html.PartialAsync(ViewNames.Shared.PluginsClient.Header, Model.PluginsClient)
    <link href="~/admin/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper d-flex p-3">
        <div class="wd-xl m-auto pb-5">
            <div class="card card-flat border">
                <div class="card-header text-center">
                    <img src="/images/logo.svg" width="150" alt="logo" class="block-center">
                </div>
                <div class="card-body">
                    <p class="text-center py-2">@Model.ProjectName</p>
                    <form method="post">
                        <div class="form-group">
                            <div class="input-group">
                                <input name="@nameof(Model.Username)" type="text" placeholder="ელ-ფოსტა" autocomplete="off" class="form-control" value="@Model.Username">
                                <div class="input-group-append"><span class="input-group-text text-muted"><i class="fas fa-envelope"></i></span></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="input-group">
                                <input name="@nameof(Model.Password)" type="password" placeholder="პაროლი" class="form-control" value="@Model.Password">
                                <div class="input-group-append"><span class="input-group-text text-muted"><i class="fas fa-lock-alt"></i></span></div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-start">
                            <div class="checkbox c-checkbox mt-0">
                                <label><input type="checkbox" name="@nameof(Model.IsRememberMeChecked)" value="true" /><span class="far fa-check"></span> დამიმახსოვრე</label>
                            </div>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-block btn-primary mt-2">ავტორიზაცია</button>
                        </div>
                    </form>
                    @if (Model.IsLoginFailed)
                    {
                        <p class="text-center text-danger">@Model.ErrorMessage</p>
                    }
                </div>
            </div>
            <div class="pt-2 text-center">
                <span>63BITS LLC</span>
            </div>
        </div>
    </div>
</body>
</html>