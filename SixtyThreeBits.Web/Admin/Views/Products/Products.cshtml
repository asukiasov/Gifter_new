@model ProductsModel.PageViewModel

<div class="actions-row">
    @if (Model.ShowAddNewButton)
    {
        <button class="btn btn-oval btn-default js-add-new-button"><i class="fas fa-plus"></i> დამატება</button>
    }
    @if (Model.ShowExcelUploadButton)
    {
        <button class="btn btn-oval btn-default js-upload-excel-button"><i class="fas fa-upload"></i> ნაშთის ატვირთვა</button>
    }
</div>

<div class="row">
    <div class="col">
        @Model.Grid.Render(Html)
    </div>
</div>
@section FooterSection{
    @if (Model.ShowExcelUploadButton)
    {
        <div class="modal fade js-upload-excel-file-modal" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-dialog-scrollable modal-xl">
                <div class="modal-content">
                    
                    <div class="modal-header">
                        <h4 class="modal-title"> ექსელის ფაილის ატვირთვა</h4>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">

                        <div class="row">
                            <div class="form-group col-lg-12">
                                <label> ფაილის ატვირთვა</label>
                                <div class="input-group custom-file-group js-custom-file-upload">
                                    <div class="form-control">
                                        <span class="js-new-attachment hidden"></span>
                                    </div>
                                    <span class="input-group-btn">
                                        <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                                        <span class="btn btn-default custom-file-upload">
                                            <i class="fas fa-folder-open"></i>
                                            <input type="file" class="js-excel-file-input" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" />
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col js-excel-errors">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <a href="@Html.Raw(Model.UrlExcelDownload)" class="btn btn-oval btn-default js-download-excel-file-button"><i class="fas fa-download"></i> ექსელის შაბლონის გადმოწერა</a>
                        <button class="btn btn-oval btn-primary js-upload-excel-file-button"><i class="fas fa-upload"></i> ატვირთვა</button>
                    </div>                                                            
                </div>
            </div>
        </div>
    }
    <script src="~/admin/js/Products/Products.js"></script>
    @if (Model.ShowExcelUploadButton)
    {
        <script>
            ProductsModel.UrlExcelUpload = '@Html.Raw(Model.UrlExcelUpload)';
        </script>
    }
}
