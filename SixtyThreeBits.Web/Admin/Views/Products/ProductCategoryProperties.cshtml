@model CategoryPropertiesModel.ProductCategoryPropertiesViewModel

<div class="actions-row">
    <button type="submit" class="btn btn-circle btn-primary js-save-button" form="CategoryPropertiesForm"><i class="fas fa-save"></i></button>
</div>

<div class="card">
    <div class="card-body">
        <form id="CategoryPropertiesForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>დასახელება *</label>
                    <input type="text" name="@nameof(Model.ProductCategoryName)" class="form-control" value="@Model.ProductCategoryName" />
                    <p class="help-block">
                        <span class="error-text"></span>
                    </p>
                </div>
                <div class="form-group col-lg-4">
                    <label>დასახელება ინგლისურად</label>
                    <input type="text" name="@nameof(Model.ProductCategoryNameEng)" class="form-control" value="@Model.ProductCategoryNameEng" />
                </div>
                <div class="form-group col-lg-4">
                    <label>დასახელება რუსულად</label>
                    <input type="text" name="@nameof(Model.ProductCategoryNameRus)" class="form-control" value="@Model.ProductCategoryNameRus" />
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-4">
                    <label>მოკლე აღწერა</label>
                    <textarea type="text" name="@nameof(Model.ProductCategoryDescriptionShort)" rows="7" class="form-control">@Html.Raw(Model.ProductCategoryDescriptionShort)</textarea>
                </div>
                <div class="form-group col-lg-4">
                    <label>მოკლე აღწერა ინგლისურად</label>
                    <textarea type="text" name="@nameof(Model.ProductCategoryDescriptionShortEng)" rows="7" class="form-control">@Html.Raw(Model.ProductCategoryDescriptionShortEng)</textarea>
                </div>
                <div class="form-group col-lg-4">
                    <label>მოკლე აღწერა რუსულად</label>
                    <textarea type="text" name="@nameof(Model.ProductCategoryDescriptionShortRus)" rows="7" class="form-control">@Html.Raw(Model.ProductCategoryDescriptionShortRus)</textarea>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-lg-12">
                    <label>სურათის ატვირთვა</label>
                    <div class="input-group custom-file-group js-custom-file-upload">
                        <div class="form-control">
                            <a class="js-attachment js-image-attachment" href="@Html.Raw(Model.ProductCategoryImageHttpPath)">@Html.Raw(Model.ProductCategoryImageFilename)</a>
                            <span class="js-new-attachment hidden"></span>
                        </div>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-warning hidden js-clear-button"><i class="fa fa-times"></i></button>
                            @if (Model.HasProductCategoryImage)
                            {
                                <button type="button" data-url="@Html.Raw(Model.UrlDeleteImage)" data-text-confirm="@Html.Raw(Model.TextConfirmDelete)" class="btn btn-danger js-delete-button"><i class="fas fa-trash-alt"></i></button>
                            }
                            <span class="btn btn-default custom-file-upload">
                                <i class="fas fa-folder-open"></i>
                                <input type="file" name="@nameof(Model.ProductCategoryImageFile)" accept="images/*" />
                            </span>
                        </span>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section FooterSection{
    <script src="~/admin/js/Products/ProductCategoryProperties.js"></script>
    @if (Model.HasErrors)
    {
        <script>
            Validation.Init({ErrorsJson:@Html.Raw(Model.ErrorsJson)}).ShowErrors();
        </script>
    }
}
